#!/bin/sh
# Post-install script for the Sentinel .deb.
set -e

# Create a system user for the service (idempotent).
if ! getent passwd sentinel >/dev/null; then
    adduser --system --group --home /var/lib/sentinel \
        --no-create-home --gecos "Sentinel" sentinel
fi

# Ensure state directories exist and are owned by the service user.
mkdir -p /var/lib/sentinel
chown sentinel:sentinel /var/lib/sentinel
chmod 750 /var/lib/sentinel

mkdir -p /etc/sentinel
chown root:sentinel /etc/sentinel
chmod 750 /etc/sentinel

# If a config was shipped, make sure it's readable by the service user.
if [ -f /etc/sentinel/config.json ]; then
    chown root:sentinel /etc/sentinel/config.json
    chmod 640 /etc/sentinel/config.json
fi

# Make the binary executable.
chmod 755 /opt/sentinel/sentinel

# Reload systemd and try to enable (but not start) the service.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable sentinel.service || true
fi

# Update the desktop database.
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications || true
fi

exit 0
